# Copy to .env and fill in. Never commit real secrets.

# App
ENVIRONMENT=local
LOG_LEVEL=INFO

# Anthropic (Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Embeddings (Voyage AI)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=rag-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Web search (Tavily) — optional; agent still works with vector search only
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
